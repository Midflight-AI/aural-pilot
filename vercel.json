   "regions": [
    "syd1"
   ]
  },
  "src/app/api/internal/video/process/route.ts": {
   "regions": [
    "syd1"
   ]
  },
  "src/app/api/session/observations/route.ts": {
   "regions": [
    "syd1"
   ]
  },
  "src/app/api/internal/observations/route.ts": {
   "regions": [
    "syd1"
   ]
  },
  "src/app/api/internal/health/route.ts": {
   "regions": [
    "syd1"
   ]
  }
 },
 "crons": [
  {
   "path": "/api/internal/video/process",
   "schedule": "* * * * *"
  },
  {
   "path": "/api/internal/health",
   "schedule": "* * * * *"
  }
 ]
}
